{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "beats",
    "Username": "beats",
    "Password": "beats-dev"
  },
  "AzureStorage": {
    "AccountName": "devstoreaccount1",
    "ContainerName": "artifacts",
    "ConnectionStringEnvironmentVariable": "AZURE_STORAGE_CONNECTION_STRING"
  },
  "Database": {
    "Provider": "MySql",
    "ConnectionStringEnvironmentVariable": "BEATS_DB_ANIMATOR_CONNECTION_STRING"
  },
  "FoundryAnimator": {
    "Provider": "Local",
    "ProjectEndpoint": "https://beats-foundry-animator.services.ai.azure.com/api/projects/beats-animator",
    "AgentId": "",
    "AgentName": "beats-animator",
    "ApiVersion": "v1",
    "Model": "beats-animator-gpt-5-nano",
    "TimeoutSeconds": 300,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 45,
    "TokenScope": "https://ai.azure.com/.default",
    "BearerTokenEnvironmentVariable": "FOUNDRY_ANIMATOR_BEARER_TOKEN"
  },
  "AzureSoraVideo": {
    "OpenAiEndpoint": "https://beats-sora-video.openai.azure.com",
    "DeploymentName": "beats-animator-sora-2",
    "TokenScope": "https://ai.azure.com/.default",
    "BearerTokenEnvironmentVariable": "AZURE_SORA_BEARER_TOKEN",
    "ApiKeyEnvironmentVariable": "AZURE_SORA_API_KEY",
    "BlobServiceEndpoint": "https://storiess.blob.core.windows.net",
    "InputContainerName": "animator-inputs",
    "OutputContainerName": "animator-outputs",
    "StorageConnectionStringEnvironmentVariable": "AZURE_ANIMATOR_STORAGE_CONNECTION_STRING",
    "Size": "720x1280",
    "Seconds": "8",
    "MaxClipSeconds": 12,
    "TimeoutSeconds": 420,
    "PollIntervalSeconds": 20
  }
}
